{
  "name": "web",
  "version": "1.0.0",
  "description": "This is a minimal static web interface for the Proxion federated messaging platform. It connects to the Proxion WebSocket Gateway to provide real-time messaging, presence, and room support.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run pod-nogw.integration.test.js",
    "lint": "eslint main.js util.js filetransfer.js e2e-secondary.js voice.js notifications.js onboarding.js reactions.js pins.js media.js modals.js profile.js edit.js mute.js account-sync.js mentions.js autocomplete.js rooms.js address.js typing.js members.js friend-requests.js e2e-status.js status-banners.js connection.js transport.js podtransport.js web-account.js webdm.js dmkey.js webpresence.js webcalls.js webjoin.js webrooms.js rendering.js view.js invite.js push.js states.js auth.js e2e.js pod.js longchat.js typeindex.js roomdesc.js ldn.js acl.js callsec.js callquality.js devices.js callstats.js solidchat.js solidchat-ui.js focus-trap.js settings-panel.js a11y.js i18n.js device-cert.js dmsig.js ssrf.js pairing.js dmhistory.js dmtext.js blocks.js send-status.js sendqueue.js podqueue.js podhealth.js notify.js recovery.js gifs.js media-resize.js gifmotion.js dropzone.js emoji.js saved.js polls.js room-emoji.js meme.js icons.js dialogs.js menu.js errors.js theme.js theme-boot.js wayfinding.js tablock.js identity.js connectivity.js sw-register.js",
    "check:solid-sdk": "node --experimental-vm-modules scripts/check_solid_sdk_versions.mjs",
    "check:contrast": "node scripts/contrast_audit.mjs",
    "check:i18n": "node scripts/i18n_check.mjs",
    "check:spacing": "node scripts/check_spacing.mjs",
    "check:type": "node scripts/check_type.mjs",
    "check:inline-styles": "node scripts/check_inline_styles.mjs",
    "check:js-colors": "node scripts/check_js_colors.mjs",
    "gen:pseudo": "node scripts/gen_pseudo_locale.mjs",
    "smoke:browser": "node smoke_browser.mjs",
    "smoke:webrtc": "node smoke_webrtc.mjs",
    "smoke:call": "node smoke_call.mjs",
    "smoke:visual": "node smoke_visual.mjs",
    "smoke:journey": "node smoke_journey.mjs",
    "smoke:rooms": "node smoke_rooms.mjs",
    "smoke:voice-channel": "node smoke_voice_channel.mjs",
    "smoke:web": "node smoke_web_nogw.mjs",
    "smoke:web-signedin": "node smoke_web_signedin.mjs",
    "smoke:web-join": "node smoke_web_join.mjs",
    "smoke:web-join-link": "node smoke_web_join_link.mjs",
    "smoke:web-dm": "node smoke_web_dm.mjs",
    "smoke:web-rooms": "node smoke_web_rooms.mjs",
    "smoke:web-session": "node smoke_web_session.mjs",
    "smoke:federation": "node smoke_federation.mjs",
    "smoke:pairing": "node smoke_pairing.mjs",
    "smoke:dmhistory": "node smoke_dm_history.mjs",
    "smoke:dmreaction": "node smoke_dm_reaction.mjs",
    "smoke:multidevice": "node smoke_multidevice_dm.mjs",
    "smoke:tabs": "node smoke_tabs.mjs",
    "smoke:sw-update": "node smoke_sw_update.mjs",
    "smoke:web-account": "node smoke_web_account.mjs",
    "smoke:a11y": "node smoke_a11y.mjs",
    "smoke:keyboard": "node smoke_keyboard.mjs",
    "smoke:pseudo": "node smoke_pseudo.mjs",
    "smoke:firstrun": "node smoke_firstrun.mjs",
    "smoke:ui": "node scripts/run-smokes.mjs ui",
    "smoke:cross-gateway": "node scripts/run-smokes.mjs cross-gateway",
    "smoke:ci": "node scripts/run-smokes.mjs ui cross-gateway",
    "smoke:all": "node scripts/run-smokes.mjs all"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@inrupt/solid-client": "^2.0.0",
    "@inrupt/solid-client-authn-browser": "^4.0.0",
    "@inrupt/solid-client-notifications": "^3.0.0",
    "@inrupt/vocab-inrupt-core": "^1.0.4",
    "@inrupt/vocab-solid": "^1.0.4",
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "@inrupt/solid-client-access-grants": "^4.0.0",
    "@inrupt/solid-client-authn-node": "^2.0.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "solid-auth-client": "npm:@inrupt/solid-client-authn-browser@^4.0.0",
    "solid-auth-fetcher": "npm:@inrupt/solid-client-authn-browser@^4.0.0"
  },
  "proxion": {
    "solidSdkPolicy": {
      "required": [
        "@inrupt/solid-client-authn-node",
        "@inrupt/solid-client-authn-browser",
        "@inrupt/solid-client",
        "@inrupt/solid-client-notifications",
        "@inrupt/vocab-solid",
        "@inrupt/vocab-inrupt-core"
      ],
      "forbidden": [
        "solid-auth-client",
        "solid-auth-fetcher"
      ],
      "allowedRanges": {
        "@inrupt/solid-client-authn-node": ">=2.0.0",
        "@inrupt/solid-client-authn-browser": ">=4.0.0",
        "@inrupt/solid-client": ">=2.0.0",
        "@inrupt/solid-client-notifications": ">=3.0.0",
        "@inrupt/vocab-solid": ">=1.0.0",
        "@inrupt/vocab-inrupt-core": ">=1.0.0"
      }
    }
  }
}
